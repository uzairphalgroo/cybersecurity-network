{
  "id": "multi_cloud_hybrid_transit",
  "name": "Multi-Cloud Hybrid Transit (Azure + AWS)",
  "description": "Hybrid cloud interconnect with Azure NSG allowing direct Internet inbound to database ports (3306 MySQL, 5432 PostgreSQL) and AWS IAM wildcard cross-account trust policies.",
  "cloud_provider": "Hybrid",
  "created_at": "2026-09-11T13:00:00Z",
  "version": "1.0",
  "metadata": {
    "organization": "OmniBridge Global",
    "tier": "Hybrid Transit Network",
    "classification": "Multi-Cloud Ingress Flaw"
  },
  "iam_users": [
    {
      "username": "hybrid_sync_agent",
      "arn": "arn:aws:iam::889900112233:user/hybrid_sync_agent",
      "mfa_enabled": false,
      "access_keys": [
        {
          "access_key_id": "AKIAHYBRIDSYNCKEY01",
          "status": "Active",
          "create_date": "2026-06-10T12:00:00Z",
          "last_rotated_days_ago": 101
        }
      ],
      "attached_policies": [
        "arn:aws:iam::889900112233:policy/CrossAccountSyncPolicy"
      ],
      "attached_roles": [],
      "groups": ["SyncAgents"]
    }
  ],
  "iam_roles": [
    {
      "role_name": "WildcardCrossAccountRole",
      "arn": "arn:aws:iam::889900112233:role/WildcardCrossAccountRole",
      "assume_role_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": { "AWS": "*" },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "attached_policies": [
        "arn:aws:iam::aws:policy/PowerUserAccess"
      ],
      "inline_policies": [],
      "trusts_wildcard": true
    }
  ],
  "iam_policies": [
    {
      "policy_name": "CrossAccountSyncPolicy",
      "arn": "arn:aws:iam::889900112233:policy/CrossAccountSyncPolicy",
      "statements": [
        {
          "effect": "Allow",
          "action": ["s3:GetObject", "s3:PutObject"],
          "resource": ["arn:aws:s3:::omnibridge-sync-bucket/*"]
        }
      ],
      "is_admin_policy": false
    }
  ],
  "s3_buckets": [
    {
      "name": "omnibridge-sync-bucket",
      "arn": "arn:aws:s3:::omnibridge-sync-bucket",
      "region": "us-east-2",
      "versioning_enabled": true,
      "encryption_enabled": true,
      "kms_key_id": "arn:aws:kms:us-east-2:889900112233:key/sync-01",
      "public_access_block": {
        "BlockPublicAcls": true,
        "IgnorePublicAcls": true,
        "BlockPublicPolicy": true,
        "RestrictPublicBuckets": true
      },
      "acl_grants": [],
      "contains_sensitive_data": false,
      "data_classification": "Internal"
    }
  ],
  "security_groups": [],
  "azure_role_assignments": [
    {
      "principal_name": "external_vendor_app",
      "role_definition_name": "Owner",
      "scope": "/subscriptions/sub-hybrid-01/resourceGroups/rg-hybrid-transit",
      "principal_type": "ServicePrincipal"
    }
  ],
  "azure_nsgs": [
    {
      "id": "/subscriptions/sub-hybrid-01/resourceGroups/rg-hybrid-transit/providers/Microsoft.Network/networkSecurityGroups/nsg-hybrid-db",
      "name": "nsg-hybrid-db",
      "resource_group": "rg-hybrid-transit",
      "security_rules": [
        {
          "name": "Allow-MySQL-Internet",
          "priority": 100,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "source_port_range": "*",
          "destination_port_range": "3306",
          "source_address_prefix": "Internet",
          "destination_address_prefix": "*"
        },
        {
          "name": "Allow-Postgres-Internet",
          "priority": 110,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "source_port_range": "*",
          "destination_port_range": "5432",
          "source_address_prefix": "Internet",
          "destination_address_prefix": "*"
        }
      ]
    }
  ],
  "k8s_role_bindings": []
}
