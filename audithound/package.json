{
  "name": "audit-hound",
  "version": "1.0.0",
  "description": "Autonomous Cloud Security & Compliance Auditing Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "cd backend && pytest -v",
    "build": "cd frontend && npm run build",
    "lint": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
